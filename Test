var logEl = document.getElementById('log');
function say(t, c){
  var li = document.createElement('li');
  li.className = c || 'info';
  li.textContent = t;
  logEl.appendChild(li);
}
window.say = say;
say('1 ✓ JavaScript normal funciona', 'ok');
window.addEventListener('error', function(e){ say('✗ Error JS: ' + e.message, 'ko'); });
window.addEventListener('unhandledrejection', function(e){
  say('✗ Promesa rechazada: ' + ((e.reason && e.reason.message) || e.reason), 'ko');
});
</script>

